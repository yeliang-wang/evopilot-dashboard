{
  "name": "evopilot-dashboard",
  "version": "2.3.0",
  "private": true,
  "description": "Chat-first Agent Console for EvoPilot project evolution loops through its HTTP API control plane.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && node tests/static-contract.test.mjs && npm run verify:oss-governance && npm run verify:distribution",
    "test:browser": "npm run test:e2e:mock && npm run test:visual",
    "test:e2e:mock": "playwright test tests/e2e --project=chromium --project=mobile-chromium",
    "test:e2e:live": "EVOPILOT_LIVE_E2E=1 playwright test tests/e2e/live-api.spec.ts --project=chromium",
    "test:visual": "playwright test tests/visual --project=chromium",
    "release:artifact": "node scripts/build-release-artifacts.mjs",
    "verify:release-artifact": "node scripts/verify-release-artifacts.mjs",
    "dashboard:run": "node scripts/run-dashboard-container.mjs",
    "verify:distribution": "node scripts/verify-distribution-readiness.mjs",
    "smoke:console": "node scripts/dashboard-console-smoke.mjs",
    "smoke:production": "node scripts/production-compat-smoke.mjs",
    "verify:oss-governance": "node scripts/verify-open-source-governance.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
